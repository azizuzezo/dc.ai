# Copy this file to .env and fill in real values. Never commit .env.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --- gemini-web2api ---
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Supabase (app runtime: history/settings/allowlist) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Pooler/direct connection used only by `npm run migrate`, not by the running bot.
SUPABASE_DB_URL=

# --- Tuning ---
AI_HISTORY_LIMIT=10
AI_COOLDOWN_MS=8000
FLOOD_LIMIT=6
FLOOD_WINDOW_MS=10000

# --- Admin dashboard ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PORT=3001
SESSION_SECRET=

# --- Strix pentest integration (/scan command) ---
# Deliberately separate from AI_API_KEY above: gemini-web2api cannot handle
# Strix's large agentic tool-calling payloads (confirmed via spike — see
# ENGINEERING.md), so Strix needs the real Google AI Studio API, not the
# proxy. Get a free key at https://aistudio.google.com/api-keys. Use a
# "Flash Lite" model, not plain Flash — plain Flash's free tier is only
# ~20 requests/day on newer model versions (checked against a real
# account, not documentation), which a single multi-turn agent scan can
# exhaust on its own. Flash Lite's free tier is ~500 requests/day.
# Never reuse AI_API_KEY here or vice versa.
STRIX_LLM_MODEL=gemini/gemini-3.5-flash-lite
STRIX_GEMINI_API_KEY=
