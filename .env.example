# Copy this file to .env and fill in real values. Never commit .env.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --- gemini-web2api ---
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Supabase (app runtime: history/settings/allowlist) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Pooler/direct connection used only by `npm run migrate`, not by the running bot.
SUPABASE_DB_URL=

# --- Tuning ---
AI_HISTORY_LIMIT=10
AI_COOLDOWN_MS=8000
FLOOD_LIMIT=6
FLOOD_WINDOW_MS=10000

# --- Admin dashboard ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PORT=3001
SESSION_SECRET=
