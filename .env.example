# Copy this file to .env and fill in real values. Never commit .env.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --- gemini-web2api ---
AI_BASE_URL=
AI_API_KEY=
# Append @think=0 for fast replies — the default "thinking" depth on this
# proxy took ~64s for a trivial reply in testing; @think=0 dropped that to
# ~8s with no visible quality loss. Higher values (up to 4) think longer/
# deeper at the cost of latency; see ENGINEERING.md for how this was found.
AI_MODEL=gemini-3.6-flash@think=0

# --- Supabase (app runtime: history/settings/allowlist) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Pooler/direct connection used only by `npm run migrate`, not by the running bot.
SUPABASE_DB_URL=

# --- Tuning ---
AI_HISTORY_LIMIT=10
AI_COOLDOWN_MS=8000
FLOOD_LIMIT=6
FLOOD_WINDOW_MS=10000

# --- Admin dashboard ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PORT=3001
SESSION_SECRET=

# --- Strix pentest integration (/scan command) ---
# Deliberately separate from AI_API_KEY above: gemini-web2api cannot handle
# Strix's large agentic tool-calling payloads (confirmed via spike — see
# ENGINEERING.md), so Strix needs the real Google AI Studio API, not the
# proxy. Get a free key at https://aistudio.google.com/api-keys. Use a
# "Flash Lite" model, not plain Flash — plain Flash's free tier is only
# ~20 requests/day on newer model versions (checked against a real
# account, not documentation), which a single multi-turn agent scan can
# exhaust on its own. Flash Lite's free tier is ~500 requests/day.
# Never reuse AI_API_KEY here or vice versa.
STRIX_LLM_MODEL=gemini/gemini-3.5-flash-lite
STRIX_GEMINI_API_KEY=
# Your own Discord user ID — always authorized to run /scan, in every guild.
# Additional approved operators are managed at /scan-operators in the
# admin dashboard.
OWNER_DISCORD_ID=
STRIX_MAX_BUDGET_USD=5
STRIX_MAX_TURNS=20
# Hard wall-clock kill switch — a stuck scan (e.g. an LLM request looping
# on retries) gets force-killed after this long, so it can't block the
# single global scan slot indefinitely. Default 20 minutes.
STRIX_SCAN_TIMEOUT_MS=1200000

# --- Music (/play, /skip, /queue, ...) ---
# Points at the separate Lavalink service (see lavalink/ in this repo — it's
# deployed as its own Railway service, not part of this container). If left
# unset, music commands are disabled and everything else keeps working.
# On Railway: host = that service's public domain, port = 443, secure = true.
# Running Lavalink locally instead: host = localhost, port = 2333, secure = false.
LAVALINK_HOST=
LAVALINK_PORT=2333
# Must match the password set on the Lavalink service (its LAVALINK_PASSWORD env var).
LAVALINK_PASSWORD=
LAVALINK_SECURE=false

# --- Job search (/jobs) ---
# Free key from https://jooble.org/api/about — covers Indonesia (unlike Adzuna,
# whose API doesn't). If unset, /jobs falls back to plain search-page links.
JOOBLE_API_KEY=

# --- Donations (/donate, admin dashboard → Donations) ---
# Only needed for the /donate command to print a full link; the donate page
# and overlay themselves work without it (dashboard shows relative links).
# Gateway URL/API key per server are configured per-guild in the dashboard,
# not here — see docs/donations.md.
PUBLIC_BASE_URL=

# --- Donation alert TTS (Gemini) ---
# Comma-separated Gemini API keys, tried in order and rotated on quota errors
# (free keys from https://aistudio.google.com/api-keys). Optional: the alert
# still shows/chimes without it, it just won't narrate the message out loud.
GEMINI_TTS_API_KEYS=

# --- Personal Rich Presence (scripts/rich-presence.mjs, runs locally only) ---
# Client ID of a SEPARATE Discord Application (Developer Portal) dedicated to
# your own Rich Presence, so the "Playing ..." card shows its own name/icon
# instead of this bot's. If left unset, falls back to DISCORD_CLIENT_ID above
# and the card will show the bot's name. See docs/rich-presence.md.
RICH_PRESENCE_CLIENT_ID=
